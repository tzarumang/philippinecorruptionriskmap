{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@pcrm/types": ["../../packages/types/src/index.ts"],
      "@pcrm/types/*": ["../../packages/types/src/*"],
      "@pcrm/resolution": ["../../packages/resolution/src/index.ts"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/types/src/**/*.ts",
    "../../packages/resolution/src/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts"]
}
