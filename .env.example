# Committed template. Names and placeholders only — never real values.
# Copy to .env.local (git-ignored) and fill in.

# --- Supabase (self-hosted) ---
# The API URL of your self-hosted Supabase instance.
# Local default from `supabase start` is http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable/anon key. Safe to ship to the browser — its safety rests
# entirely on Row Level Security, not on secrecy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. BYPASSES RLS. Server-only.
# Never prefix with NEXT_PUBLIC_. Only read from modules guarded by
# `import 'server-only'`. Used by the ingestion CLI to load snapshots.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingestion ---
# Directory for immutable, checksummed snapshots.
PCRM_SNAPSHOT_DIR=./data/snapshots
