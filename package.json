{
  "name": "pcrm",
  "private": true,
  "version": "0.1.0",
  "description": "Philippine Corruption Risk Map — monorepo root",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@pcrm/web",
    "build": "npm run build --workspace=@pcrm/web",
    "ingest": "tsx packages/ingestion/src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace=@pcrm/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "load": "tsx packages/ingestion/src/load.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
