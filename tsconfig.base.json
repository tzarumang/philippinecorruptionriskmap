{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,

    "paths": {
      "@pcrm/types": ["./packages/types/src/index.ts"],
      "@pcrm/types/*": ["./packages/types/src/*"],
      "@pcrm/ingestion": ["./packages/ingestion/src/index.ts"],
      "@pcrm/ingestion/*": ["./packages/ingestion/src/*"],
      "@pcrm/resolution": ["./packages/resolution/src/index.ts"],
      "@pcrm/resolution/*": ["./packages/resolution/src/*"]
    }
  }
}
